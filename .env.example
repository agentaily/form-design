# Base URL of the Agentaily Forms backend (Cloudflare Workers).
# Empty → same-origin relative requests (/api/*). Set this when the frontend and
# backend live on different origins (the production default), e.g.:
#   VITE_API_BASE=https://forms-api.agentaily.com
# Local backend (cd workers && npx wrangler dev) usually serves on:
#   VITE_API_BASE=http://127.0.0.1:8787
VITE_API_BASE=
